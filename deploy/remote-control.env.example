# Opt-in staging configuration. Merge with the existing app environment securely.
REMOTE_CONTROL_ENABLED=false
REMOTE_ASSIST_RELEASE_DIR=./remote-assist/releases
# Set only after Authenticode verification of the signed release:
REMOTE_ASSIST_SHA256=
# Native build only; build.ps1 -TrustedOrigin sets this for the compiler.
# SNAPKEY_REMOTE_ASSIST_ORIGIN=https://your-approved-staging-host
